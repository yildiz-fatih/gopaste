{{ define "base" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>gopaste</title>
    <link rel="icon" href="/static/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
    <style>
        :root {
            color-scheme: dark;
            --accent: #0ce725;
            --border: rgba(255,255,255,0.15);
        }

        /* fullscreen layout */
        body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; font-family: ui-monospace, "SF Mono", "Cascadia Code", "Cascadia Mono", Consolas, Menlo, monospace; }

        /* text selection + caret match the accent */
        ::selection { background: var(--accent); color: black; }
        textarea { caret-color: var(--accent); }

        /* main content */
        pre, textarea {
            font-family: inherit;
            font-size: 20px;
            padding: 16px;
            padding-bottom: 80px;
            margin: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            background: transparent;
        }
        textarea { border: none; resize: none; outline: none; }
        pre code { padding: 0 !important; background: transparent !important; }
        pre { overflow: auto; white-space: pre-wrap; word-break: break-word; }
        code { font-family: inherit; }

        /* ---- bottom dock ---- */
        .dock {
            position: fixed;
            left: 50%;
            bottom: 0;
            transform: translateX(-50%);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 16px;
            max-width: calc(100% - 32px);
            padding: 12px 16px;
            border: 1px solid var(--border);
            border-bottom: none;
            border-radius: 2px 2px 0 0;
            background: black;
            font-size: 14px;
            user-select: none;
        }

        .dock-sep { width: 1px; align-self: stretch; background: var(--border); }

        .dock-key { opacity: 0.65; margin-right: 2px; }

        .dock-btn {
            font-family: inherit;
            font-size: inherit;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 2px;
            padding: 8px 12px;
            cursor: pointer;
            box-sizing: border-box;
        }
        .dock-btn:hover { border-color: var(--border); }
        .dock-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
        .dock-btn:active { background: var(--border); }

        .dock-btn--primary { background: var(--accent); color: black; border-color: var(--accent); min-width: 70px; text-align: center; }
        .dock-btn--primary:hover { filter: brightness(1.08); }
        .dock-btn--primary:active { filter: brightness(0.92); }

        .dock-text { opacity: 0.55; white-space: nowrap; }
        .dock-url { overflow: hidden; text-overflow: ellipsis; cursor: pointer; text-align: center; }

        .dock-slot { display: flex; align-items: center; justify-content: center; gap: 16px; width: 190px; overflow: hidden; }
        .dock-slot-wide { width: 220px; }

        .dock-select, .dock-input {
            font-family: inherit;
            font-size: inherit;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 2px;
            padding: 8px 12px;
            box-sizing: border-box;
        }
        .dock-select:focus-visible, .dock-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
    </style>
</head>
<body>
    {{ template "main" . }}

    <script src="/static/js/main.js"></script>
</body>
</html>
{{ end }}