{{ define "base" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>gopaste</title>
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="stylesheet" media="(prefers-color-scheme: light)" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.css">
    <link rel="stylesheet" media="(prefers-color-scheme: dark)" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
    <script src="/static/js/qrcode.min.js"></script>
    <style>
        /* light-dark mode */
        :root { color-scheme: light dark; }
        /* fullscreen layout */
        body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; font-family: monospace; }
        /* main content */
        pre, textarea {
            font-family: inherit;
            font-size: 20px;
            padding: 20px;
            margin: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            background: transparent;
        }
        textarea { border: none; resize: none; outline: none; }
        pre code { padding: 0 !important; background: transparent !important; }
        pre { overflow: auto; white-space: pre-wrap; word-break: break-word; }
        code { font-family: inherit; }
        /* pin controls to top-right */
        .controls { position: fixed; right: 0; z-index: 10; user-select: none; }
        /* top controls */
        #top { top: 0; width: 200px; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 0 0 0 8px; background: light-dark(rgba(0,0,0,0.06), rgba(255,255,255,0.07)); }
        .icon-row { display: flex; align-items: center; }
        #top button { background: transparent; border: none; cursor: pointer; padding: 0 8px; }
        #top button img { width: 32px; height: 32px; }
        /* shareable link */
        .paste-url { font-size: 11px; text-align: center; opacity: 0.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; cursor: pointer; }
        /* disable qr code img select and drag */
        #qrcode img { pointer-events: none; -webkit-user-drag: none; user-select: none; }
        /* invert icons in dark mode */
        @media (prefers-color-scheme: dark) {
            #top img {
                filter: invert(1);
            }
        }
    </style>
</head>
<body>
    {{ template "main" . }}

    <script src="/static/js/main.js"></script>
</body>
</html>
{{ end }}
