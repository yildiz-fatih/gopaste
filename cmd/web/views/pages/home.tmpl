{{ define "main" }}
<form action="/paste" method="POST" style="height: 100%;">

    <textarea name="content" placeholder="type (or paste) something..." autofocus></textarea>

    <div class="dock">
        <button type="submit" class="dock-btn dock-btn--primary"><span class="dock-key">^S</span> Save</button>
        <button type="button" class="dock-btn" onclick="window.location.href='/'"><span class="dock-key">^N</span> New</button>
        <button type="button" class="dock-btn" onclick="window.location.href='/paste/help'">Help</button>

        <span class="dock-sep"></span>

        <span class="dock-slot">
            <label for="expires" class="dock-text">expires</label>
            <select name="expires" id="expires" class="dock-select">
                <option value="1">1h</option>
                <option value="24">1d</option>
                <option value="168">1w</option>
            </select>
        </span>

        <span class="dock-sep"></span>

        <input type="password" name="password" id="password" placeholder="password (optional)" class="dock-input dock-slot-wide">
    </div>

</form>

<script>
    document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.key === 's') {
            e.preventDefault()
            document.querySelector('form').submit()
        }
        if (e.ctrlKey && e.key === 'n') {
            e.preventDefault()
            window.location.href = '/'
        }
    })
</script>
{{ end }}