{{ define "main" }}

{{ if .Paste }}

<pre id="content"><code>{{ .Paste.Content }}</code></pre>

<div class="dock">
    <button type="button" class="dock-btn dock-btn--primary" id="copy-content">Copy</button>
    <button type="button" class="dock-btn" onclick="window.location.href='/'"><span class="dock-key">^N</span> New</button>
    <button type="button" class="dock-btn" onclick="window.location.href='/paste/help'">Help</button>

    <span class="dock-sep"></span>

    <span class="dock-text dock-slot">exp {{ .Paste.Expires.Format "2 Jan 2006" }}</span>

    <span class="dock-sep"></span>

    <span class="dock-text dock-url paste-url dock-slot-wide">{{ .FullURL }}</span>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // highlight code
        const block = document.querySelector('#content code')
        hljs.highlightElement(block)
    })

    document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.key === 'n') {
            e.preventDefault()
            window.location.href = '/'
        }
    })
</script>

{{ else }}
<div class="lock">
    <form action="{{ .FullURL }}" method="POST">
        <img src="/static/icons/lock.svg" alt="Locked">
        {{ if .Error }}
            <p>{{ .Error }}</p>
        {{ end }}
        <input type="password" name="password" id="password" placeholder="password">
        <button type="submit">unlock</button>
    </form>
</div>

<style>
    .lock { height: 100%; display: flex; align-items: center; justify-content: center; }
    .lock form { display: flex; flex-direction: column; align-items: center; gap: 12px; }
    .lock img { width: 32px; height: 32px; filter: invert(1); }
    .lock input, .lock button { font-size: 16px; padding: 10px 14px; }
</style>
{{ end }}

{{ end }}